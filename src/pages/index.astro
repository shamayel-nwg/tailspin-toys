---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/60 p-6 md:grid-cols-2" data-testid="game-filters">
            <fieldset>
              <legend class="mb-3 text-sm font-semibold text-slate-100">Filter by category</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label class="flex items-center gap-2 text-sm text-slate-300">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      data-testid={`category-filter-${category.id}`}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-100">Filter by publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                data-testid="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>

            <div class="flex items-center justify-between gap-4 md:col-span-2">
              <p class="text-sm text-slate-300" data-testid="filter-result-count" aria-live="polite">{games.length} games shown</p>
              <button
                type="button"
                data-testid="clear-filters"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                Clear filters
              </button>
            </div>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filtered-empty">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty"]');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');

  if (filterForm && resultCount && emptyState && clearButton) {
    const categoryInputs = Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherInput = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]');

    const applyFilters = (updateUrl: boolean): void => {
      const selectedCategories = categoryInputs.filter((input) => input.checked).map((input) => input.value);
      const selectedPublisher = publisherInput?.value ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(card.dataset.categoryId ?? '');
        const matchesPublisher = selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const visible = matchesCategory && matchesPublisher;
        card.classList.toggle('hidden', !visible);
        if (visible) visibleCount += 1;
      });

      resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;
      emptyState.classList.toggle('hidden', visibleCount !== 0);

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.search = '';
        selectedCategories.forEach((category) => url.searchParams.append('category', category));
        if (selectedPublisher !== '') url.searchParams.set('publisher', selectedPublisher);
        window.history.replaceState({}, '', url);
      }
    };

    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });
    if (publisherInput) publisherInput.value = params.get('publisher') ?? '';

    filterForm.addEventListener('change', () => applyFilters(true));
    clearButton.addEventListener('click', () => {
      categoryInputs.forEach((input) => {
        input.checked = false;
      });
      if (publisherInput) publisherInput.value = '';
      applyFilters(true);
    });
    applyFilters(false);
  }
</script>
